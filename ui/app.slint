import { Palette, Spinner } from "std-widgets.slint";

export struct LanguageItem {
    code: string,
    name: string,
}

// Design tokens of the quick translate popup (light / dark).
export global Theme {
    in-out property <bool> dark: false;

    out property <color> card: dark ? #292929 : #f5f5f5;
    out property <color> surface: dark ? #292929 : #ffffff;
    out property <color> border: dark ? #3e3e3e : #e5e5e5;
    out property <color> text: dark ? #f5f5f5 : #292929;
    out property <color> text-muted: dark ? #c6c6c6 : #6f6f6f;
    out property <color> danger: dark ? #ffb2a7 : #963326;

    out property <color> basic-bg: dark ? #292929 : #ffffff;
    out property <color> basic-bg-hover: dark ? #3e3e3e : #f5f5f5;
    out property <color> basic-bg-pressed: dark ? #191919 : #e5e5e5;
    out property <color> basic-border: dark ? #555555 : #e5e5e5;
    out property <color> basic-border-hover: dark ? #3e3e3e : #c6c6c6;
    out property <color> basic-border-pressed: dark ? #191919 : #ababab;

    out property <color> ghost-hover: dark ? #00000026 : #0000000d;
    out property <color> ghost-pressed: dark ? #00000040 : #0000001a;

    out property <color> primary: #0070c9;
    out property <color> primary-hover: #0053a9;
    out property <color> primary-pressed: #00388d;
    out property <color> primary-text: #edf6ff;

    out property <color> disabled-bg: dark ? #00000026 : #00000008;
    out property <color> disabled-text: dark ? #ffffff59 : #00000040;

    out property <color> active-bg: dark ? #00388d : #edf6ff;
    out property <color> active-border: #0070c9;
    out property <color> active-text: dark ? #edf6ff : #0053a9;
    out property <color> item-hover: dark ? #3e3e3e : #e5e5e5;
    out property <color> focus: dark ? #ffffff : #0070c9;

    out property <color> scroll-thumb: dark ? #ababab : #c6c6c6;
    out property <color> scroll-thumb-hover: dark ? #f5f5f5 : #ababab;

    out property <color> tooltip-bg: dark ? #555555 : #ffffff;
    out property <color> tooltip-text: dark ? #ffffff : #191919;
    out property <color> tooltip-border: dark ? #a9a9a9 : #d3d3d3;
    out property <color> key-bg: dark ? #3e3e3e : #f5f5f5;
    out property <color> key-border: dark ? #6f6f6f : #c6c6c6;

    out property <color> card-shadow: dark ? #00000099 : #00000059;

    out property <color> toast-bg: #555555;
    out property <color> toast-text: #ffffff;
}

// Icons come from the Segoe Fluent Icons system font. The height is left to the
// layout so the icon is centered on the row.
component Glyph inherits Text {
    width: 20px;
    min-height: 20px;
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: none;
}

component KeyChip inherits Rectangle {
    in property <string> label;

    min-width: self.height;
    height: 22px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.key-border;
    background: Theme.key-bg;

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;

        Text {
            text: root.label;
            color: Theme.tooltip-text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component Tip inherits Rectangle {
    in property <string> text;
    in property <string> key-hint;

    width: min(320px, tip-layout.preferred-width);
    height: tip-layout.preferred-height;
    background: Theme.tooltip-bg;
    border-width: 1px;
    border-color: Theme.tooltip-border;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000026;

    tip-layout := VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Text {
            text: root.text;
            color: Theme.tooltip-text;
            font-size: 14px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        if root.key-hint != "": HorizontalLayout {
            alignment: center;
            spacing: 4px;

            KeyChip { label: "Ctrl"; }
            Text {
                text: "+";
                color: Theme.tooltip-text;
                font-size: 14px;
                vertical-alignment: center;
            }
            KeyChip { label: root.key-hint; }
        }
    }
}

// Place with the focused element's size plus 4px.
component FocusRing inherits Rectangle {
    x: -2px;
    y: -2px;
    border-width: 2px;
    border-color: Theme.focus;
    border-radius: 6px;
}

// Pointer handling shared by the buttons: clicks, hover and a tooltip that
// appears after the pointer rests for a moment.
component HoverTouch inherits TouchArea {
    in property <bool> tip-enabled: true;
    out property <bool> tip-shown: self.tip-ready && self.has-hover && root.tip-enabled;
    private property <bool> tip-ready: false;
    callback activated();

    changed has-hover => {
        if !self.has-hover {
            self.tip-ready = false;
        }
    }
    clicked => {
        self.tip-ready = false;
        root.activated();
    }

    Timer {
        interval: 500ms;
        running: root.has-hover && !root.tip-ready;
        triggered => {
            root.tip-ready = true;
        }
    }
}

// Lets a focused button be pressed with Space or Enter.
component KeyActivator inherits FocusScope {
    callback activated();

    x: 0px;
    width: 0px;
    key-pressed(event) => {
        if event.text == " " || event.text == Key.Return {
            root.activated();
            return accept;
        }
        return reject;
    }
}

// Bordered or primary button with an icon, like the bottom row of the popup.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <string> tooltip;
    in property <string> tooltip-key;
    in property <bool> tooltip-align-right: false;
    callback clicked();

    private property <color> foreground: !root.enabled
        ? Theme.disabled-text
        : (root.primary ? Theme.primary-text : Theme.text);

    z: touch.tip-shown ? 10 : 0;
    height: 36px;
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: !root.enabled || root.primary ? 0px : 1px;
    border-color: touch.pressed
        ? Theme.basic-border-pressed
        : (touch.has-hover ? Theme.basic-border-hover : Theme.basic-border);
    background: !root.enabled
        ? Theme.disabled-bg
        : root.primary
            ? (touch.pressed ? Theme.primary-pressed : (touch.has-hover ? Theme.primary-hover : Theme.primary))
            : (touch.pressed ? Theme.basic-bg-pressed : (touch.has-hover ? Theme.basic-bg-hover : Theme.basic-bg));
    forward-focus: key-focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;

        if root.icon != "": Glyph {
            text: root.icon;
            color: root.foreground;
        }

        Text {
            text: root.label;
            color: root.foreground;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := HoverTouch {
        enabled: root.enabled;
        tip-enabled: root.enabled && root.tooltip != "";
        activated => { root.clicked(); }
    }

    key-focus := KeyActivator {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    if key-focus.has-focus: FocusRing {
        width: root.width + 4px;
        height: root.height + 4px;
    }

    if touch.tip-shown: Tip {
        x: root.tooltip-align-right ? root.width - self.width : 0px;
        y: -self.height - 8px;
        text: root.tooltip;
        key-hint: root.tooltip-key;
    }
}

// Transparent icon-only button (settings and close in the header).
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> hint;
    in property <string> tooltip;
    // The window draws the tooltip so it stays above the following rows.
    out property <bool> tip-shown: touch.tip-shown;
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: touch.pressed ? Theme.ghost-pressed : (touch.has-hover ? Theme.ghost-hover : transparent);
    forward-focus: key-focus;
    accessible-role: button;
    accessible-label: root.hint;
    accessible-action-default => { root.clicked(); }

    Glyph {
        x: 6px;
        y: 6px;
        height: 20px;
        text: root.icon;
        color: Theme.text;
    }

    touch := HoverTouch {
        tip-enabled: root.tooltip != "";
        activated => { root.clicked(); }
    }

    key-focus := KeyActivator {
        activated => { root.clicked(); }
    }

    if key-focus.has-focus: FocusRing {
        width: root.width + 4px;
        height: root.height + 4px;
    }
}

// The single "Translate" tab of the tab strip, always selected.
component TabStrip inherits Rectangle {
    in property <string> icon;
    in property <string> label;

    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 5px;

        Rectangle {
            height: 36px;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.active-border;
            background: Theme.active-bg;
            accessible-role: tab;
            accessible-label: root.label;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;

                Glyph {
                    text: root.icon;
                    color: Theme.active-text;
                }

                Text {
                    text: root.label;
                    color: Theme.active-text;
                    font-size: 14px;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
    }
}

component DropdownTrigger inherits Rectangle {
    in property <string> label;
    in property <bool> open;
    in property <bool> enabled: true;
    in property <string> tooltip;
    // The window draws the tooltip so it stays above the following rows.
    out property <bool> tip-shown: touch.tip-shown;
    callback clicked();

    private property <color> foreground: !root.enabled
        ? Theme.disabled-text
        : (root.open ? Theme.active-text : Theme.text);

    height: 40px;
    min-width: 120px;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: root.enabled ? 1px : 0px;
    border-color: root.open
        ? Theme.active-border
        : (touch.has-hover ? Theme.basic-border-hover : Theme.basic-border);
    background: !root.enabled
        ? Theme.disabled-bg
        : root.open ? Theme.active-bg : (touch.has-hover ? Theme.basic-bg-hover : Theme.basic-bg);
    accessible-role: combobox;
    accessible-label: @tr("Target language");
    accessible-value: root.label;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;

        Text {
            text: root.label;
            color: root.foreground;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            accessible-role: none;
        }

        Glyph {
            text: root.open ? "\u{E70E}" : "\u{E70D}";
            color: root.foreground;
            font-size: 12px;
        }
    }

    touch := HoverTouch {
        enabled: root.enabled;
        tip-enabled: root.enabled && !root.open && root.tooltip != "";
        activated => { root.clicked(); }
    }
}
component SearchBox inherits Rectangle {
    in-out property <string> text;
    callback accepted();

    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.active-border : Theme.border;
    background: Theme.surface;
    forward-focus: input;

    if root.text == "": HorizontalLayout {
        x: 7px;
        width: parent.width - 14px;
        spacing: 5px;

        Glyph {
            text: "\u{E721}";
            color: Theme.text-muted;
            font-size: 14px;
        }

        Text {
            text: @tr("Search languages");
            color: Theme.text-muted;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    input := TextInput {
        x: 7px;
        width: parent.width - 14px;
        text <=> root.text;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        accessible-label: @tr("Search languages");
        accepted => { root.accepted(); }
    }
}

component GroupHeader inherits Rectangle {
    in property <string> label;

    height: 32px;

    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.label;
        color: Theme.text-muted;
        font-size: 12px;
        vertical-alignment: center;
    }
}

component LanguageRow inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    callback clicked();

    height: 32px;
    accessible-role: list-item;
    accessible-label: root.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: 8px;
        width: parent.width - 8px;
        background: root.selected ? Theme.active-bg : (touch.has-hover ? Theme.item-hover : transparent);
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 12px;
        spacing: 6px;

        Glyph {
            text: root.selected ? "\u{E73E}" : "";
            color: Theme.text;
            font-size: 14px;
        }

        Text {
            text: root.name;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ResizeGrip inherits Rectangle {
    callback resize-requested();

    width: 12px;
    height: 12px;

    for dot in [{ x: 9, y: 1 }, { x: 5, y: 5 }, { x: 9, y: 5 }, { x: 1, y: 9 }, { x: 5, y: 9 }, { x: 9, y: 9 }]: Rectangle {
        x: dot.x * 1px;
        y: dot.y * 1px;
        width: 2px;
        height: 2px;
        background: Theme.text-muted;
    }

    TouchArea {
        mouse-cursor: nwse-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.resize-requested();
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <[LanguageItem]> recommended-languages;
    in property <[LanguageItem]> all-languages;
    in property <string> selected-language-code;
    in property <string> selected-language-name;
    in-out property <string> language-search;
    in property <string> result-text;
    in property <string> placeholder-text;
    in property <bool> has-result;
    in property <bool> loading;
    in property <bool> error-visible;
    in property <string> error-title;
    in property <string> error-message;
    in property <bool> error-show-settings;
    in property <bool> dark-mode;
    // Extra transparent height added below the card while the language list
    // needs more room than the card has.
    in property <length> menu-extra: 0px;
    out property <length> menu-bottom: menu.y + menu.height + 8px;
    out property <bool> menu-open: false;
    // A message shown briefly over the popup, e.g. when replacing failed.
    in-out property <string> notification;

    private property <bool> show-spinner: false;
    private property <bool> actions-enabled: root.has-result && !root.loading && !root.error-visible;

    callback hide-requested();
    callback settings-requested();
    callback drag-requested();
    callback resize-requested();
    callback menu-toggled();
    callback language-selected(string);
    callback language-search-changed(string);
    callback search-accepted();
    callback copy-requested();
    callback replace-requested();
    callback retry-requested();

    public function reset-view() {
        root.menu-open = false;
        root.notification = "";
        root.language-search = "";
        root.show-spinner = false;
        result-flick.content-y = 0px;
        page-focus.focus();
    }

    function open-menu() {
        if root.menu-open || root.error-visible {
            return;
        }
        root.language-search = "";
        language-list-flick.content-y = 0px;
        root.menu-open = true;
        search.focus();
        root.menu-toggled();
    }

    function close-menu() {
        if !root.menu-open {
            return;
        }
        root.menu-open = false;
        page-focus.focus();
        root.menu-toggled();
    }

    function choose-language(code: string) {
        root.close-menu();
        root.language-selected(code);
    }

    title: "DeepL Popup";
    icon: root.dark-mode ? @image-url("../assets/icon-dark.png") : @image-url("../assets/icon-light.png");
    preferred-width: 520px;
    preferred-height: 320px;
    min-width: 520px;
    min-height: 320px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    init => {
        Theme.dark = root.dark-mode;
    }
    changed dark-mode => {
        Theme.dark = root.dark-mode;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed language-search => {
        root.language-search-changed(root.language-search);
    }
    changed loading => {
        if !root.loading {
            root.show-spinner = false;
        }
    }

    Timer {
        interval: 5s;
        running: root.notification != "";
        triggered => { root.notification = ""; }
    }

    Timer {
        interval: 500ms;
        running: root.loading && !root.show-spinner;
        triggered => { root.show-spinner = true; }
    }

    card := Rectangle {
        x: 15px;
        y: 15px;
        width: root.width - 30px;
        height: root.height - 30px - root.menu-extra;
        border-radius: 8px;
        background: Theme.card;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.card-shadow;

        page-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.hide-requested();
                    return accept;
                }
                if event.modifiers.control {
                    if (event.text == "c" || event.text == "C" || event.text == "\u{3}") && root.actions-enabled {
                        root.copy-requested();
                        return accept;
                    }
                    if (event.text == "r" || event.text == "R" || event.text == "\u{12}") && root.actions-enabled {
                        root.replace-requested();
                        return accept;
                    }
                    return reject;
                }
                if event.text == " " {
                    root.open-menu();
                    return accept;
                }
                if event.text == Key.Return && root.actions-enabled {
                    root.replace-requested();
                    return accept;
                }
                return reject;
            }

            // Dragging the empty background moves the window.
            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        page-focus.focus();
                        root.drag-requested();
                    }
                }
            }

            VerticalLayout {
                padding: 12px;
                spacing: 12px;

                HorizontalLayout {
                    TabStrip {
                        icon: "\u{E8C1}";
                        label: @tr("Translate");
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;

                        settings-button := IconButton {
                            icon: "\u{E713}";
                            hint: @tr("Settings");
                            tooltip: @tr("Settings");
                            clicked => { root.settings-requested(); }
                        }
                    }

                    Rectangle {
                        width: 16px;
                    }

                    VerticalLayout {
                        alignment: center;

                        IconButton {
                            icon: "\u{E711}";
                            hint: @tr("Close");
                            clicked => { root.hide-requested(); }
                        }
                    }
                }

                HorizontalLayout {
                    trigger := DropdownTrigger {
                        label: root.selected-language-name;
                        open: root.menu-open;
                        enabled: !root.error-visible;
                        tooltip: @tr("Press Space to choose a language");
                        clicked => {
                            if root.menu-open {
                                root.close-menu();
                            } else {
                                root.open-menu();
                            }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }

                result-box := Rectangle {
                    vertical-stretch: 1;
                    visible: !root.error-visible;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 6px;
                    background: Theme.surface;

                    result-flick := Flickable {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 21px;
                        height: parent.height - 16px;
                        content-width: self.width;
                        content-height: max(self.height, result-input.preferred-height);
                        opacity: root.loading ? 0.2 : 1;

                        result-input := TextInput {
                            width: result-flick.width;
                            height: result-flick.content-height;
                            text: root.result-text;
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                            color: Theme.text;
                            font-size: 14px;
                            accessible-label: @tr("Translation");
                        }
                    }

                    if root.result-text == "" && !root.loading: Text {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 21px;
                        text: root.placeholder-text;
                        color: Theme.text-muted;
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    if result-flick.content-height > result-flick.height + 1px: Rectangle {
                        private property <length> track: result-flick.height;
                        private property <length> thumb: max(24px, self.track * result-flick.height / result-flick.content-height);
                        x: parent.width - 13px;
                        y: result-flick.y + (self.track - self.thumb) * (-result-flick.content-y) / (result-flick.content-height - result-flick.height);
                        width: 5px;
                        height: self.thumb;
                        background: thumb-touch.has-hover ? Theme.scroll-thumb-hover : Theme.scroll-thumb;

                        thumb-touch := TouchArea {
                            moved => {
                                if self.pressed {
                                    result-flick.content-y = clamp(
                                        result-flick.content-y - (self.mouse-y - self.pressed-y) * (result-flick.content-height - result-flick.height) / (parent.track - parent.thumb),
                                        result-flick.height - result-flick.content-height,
                                        0px);
                                }
                            }
                        }
                    }

                    if root.show-spinner: Spinner {
                        x: (parent.width - 24px) / 2;
                        y: (parent.height - 24px) / 2;
                        width: 24px;
                        height: 24px;
                        indeterminate: true;
                    }
                }

                if root.error-visible: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: root.error-title;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    Text {
                        text: root.error-message;
                        color: Theme.text;
                        font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        padding-top: 4px;
                        alignment: center;
                        spacing: 8px;

                        ActionButton {
                            label: @tr("Try again");
                            clicked => { root.retry-requested(); }
                        }

                        if root.error-show-settings: ActionButton {
                            label: @tr("Open settings");
                            clicked => { root.settings-requested(); }
                        }
                    }
                }

                if !root.error-visible: HorizontalLayout {
                    ActionButton {
                        label: @tr("Copy");
                        icon: "\u{E8C8}";
                        enabled: root.actions-enabled;
                        tooltip: @tr("Copy the translation (click or shortcut)");
                        tooltip-key: "C";
                        clicked => { root.copy-requested(); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        label: @tr("Replace");
                        icon: "\u{E8AB}";
                        primary: true;
                        enabled: root.actions-enabled;
                        tooltip: @tr("Replace the original text (click or shortcut)");
                        tooltip-key: "R";
                        tooltip-align-right: true;
                        clicked => { root.replace-requested(); }
                    }
                }
            }

            if root.notification != "": Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - 60px - self.height;
                width: min(parent.width - 24px, toast-text.preferred-width + 24px);
                height: toast-text.preferred-height + 16px;
                border-radius: 4px;
                background: Theme.toast-bg;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000033;

                toast-text := Text {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    text: root.notification;
                    color: Theme.toast-text;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }

            ResizeGrip {
                x: parent.width - 13px;
                y: parent.height - 13px;
                resize-requested => { root.resize-requested(); }
            }
        }
    }

    if settings-button.tip-shown: Tip {
        x: settings-button.absolute-position.x + settings-button.width - self.width;
        y: settings-button.absolute-position.y + settings-button.height + 8px;
        text: settings-button.tooltip;
    }

    if trigger.tip-shown: Tip {
        x: trigger.absolute-position.x;
        y: trigger.absolute-position.y + trigger.height + 8px;
        text: trigger.tooltip;
    }

    // Clicking anywhere outside the open language list closes it.
    TouchArea {
        visible: root.menu-open;
        clicked => { root.close-menu(); }
    }

    menu := Rectangle {
        private property <length> content-height: 14px + 48px + language-list.preferred-height;

        visible: root.menu-open;
        x: trigger.absolute-position.x - 2px;
        y: trigger.absolute-position.y + trigger.height + 6px;
        width: max(trigger.width + 4px, 260px);
        height: min(450px, self.content-height);
        border-radius: 8px;
        background: Theme.surface;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000033;

        // Swallow clicks on the list background so they do not close the list.
        TouchArea { }

        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.close-menu();
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding-top: 7px;
                padding-bottom: 7px;
                padding-left: 3px;
                padding-right: 3px;

                HorizontalLayout {
                    padding: 8px;

                    search := SearchBox {
                        text <=> root.language-search;
                        accepted => { root.search-accepted(); }
                    }
                }

                language-list-flick := Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: language-list.preferred-height;

                    language-list := VerticalLayout {
                        width: language-list-flick.width;
                        height: language-list-flick.content-height;
                        padding-bottom: 8px;

                        if root.recommended-languages.length > 0: GroupHeader {
                            label: @tr("Suggested languages");
                        }

                        for language in root.recommended-languages: LanguageRow {
                            name: language.name;
                            selected: language.code == root.selected-language-code;
                            clicked => { root.choose-language(language.code); }
                        }

                        if root.all-languages.length > 0: GroupHeader {
                            label: @tr("All languages");
                        }

                        for language in root.all-languages: LanguageRow {
                            name: language.name;
                            selected: language.code == root.selected-language-code;
                            clicked => { root.choose-language(language.code); }
                        }
                    }
                }
            }
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    callback accepted();

    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.active-border : Theme.border;
    background: Theme.surface;
    forward-focus: input;

    if root.text == "": Text {
        x: 7px;
        width: parent.width - 14px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: 14px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 7px;
        width: parent.width - 14px;
        text <=> root.text;
        input-type: root.password ? InputType.password : InputType.text;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(); }
    }
}

component SegmentButton inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> first;
    in property <bool> last;
    callback clicked();

    height: 32px;
    // Room for the label in bold too, so the width does not jump when checked.
    min-width: max(64px, label-text.preferred-width + 28px);
    border-top-left-radius: root.first ? 6px : 0px;
    border-bottom-left-radius: root.first ? 6px : 0px;
    border-top-right-radius: root.last ? 6px : 0px;
    border-bottom-right-radius: root.last ? 6px : 0px;
    border-width: root.checked ? 0px : 1px;
    border-color: touch.has-hover ? Theme.basic-border-hover : Theme.basic-border;
    background: root.checked
        ? Theme.primary
        : (touch.pressed ? Theme.basic-bg-pressed : (touch.has-hover ? Theme.basic-bg-hover : Theme.basic-bg));
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }

    label-text := Text {
        text: root.label;
        color: root.checked ? Theme.primary-text : Theme.text;
        font-size: 14px;
        font-weight: root.checked ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ToggleSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;

    height: 32px;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; }

    HorizontalLayout {
        spacing: 10px;

        VerticalLayout {
            alignment: center;

            track := Rectangle {
                width: 40px;
                height: 20px;
                border-radius: 10px;
                border-width: root.checked ? 0px : 1px;
                border-color: touch.has-hover ? Theme.basic-border-hover : Theme.basic-border;
                background: root.checked
                    ? Theme.primary
                    : (touch.has-hover ? Theme.basic-bg-hover : Theme.basic-bg);

                Rectangle {
                    width: touch.pressed ? 14px : 12px;
                    height: self.width;
                    border-radius: self.width / 2;
                    x: root.checked ? parent.width - self.width - 4px : 4px;
                    y: (parent.height - self.height) / 2;
                    background: root.checked ? Theme.primary-text : Theme.text-muted;
                    animate x, width { duration: 120ms; easing: ease-out; }
                }
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    touch := TouchArea {
        clicked => { root.checked = !root.checked; }
    }
}

/// A closed box showing the chosen option; the options open in a list below it.
component SelectBox inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index;
    in property <string> name;

    height: 36px;
    width: 180px;
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.basic-border-hover : Theme.basic-border;
    background: touch.pressed ? Theme.basic-bg-pressed : (touch.has-hover ? Theme.basic-bg-hover : Theme.basic-bg);
    accessible-role: combobox;
    accessible-label: root.name;
    accessible-value: root.options[root.current-index];
    accessible-expandable: true;
    accessible-action-default => { list.show(); }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 6px;

        Text {
            text: root.options[root.current-index];
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        Glyph {
            text: "\u{E70D}";
            color: Theme.text;
            font-size: 12px;
        }
    }

    touch := TouchArea {
        clicked => { list.show(); }
    }

    list := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;

        Rectangle {
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.basic-border;
            background: Theme.surface;
            drop-shadow-blur: 8px;
            drop-shadow-color: Theme.card-shadow;

            VerticalLayout {
                padding: 4px;

                for option[index] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: index == root.current-index
                        ? Theme.active-bg
                        : (item-touch.has-hover ? Theme.item-hover : transparent);
                    accessible-role: list-item;
                    accessible-label: option;
                    accessible-item-selectable: true;
                    accessible-item-selected: index == root.current-index;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 4px;

                        Glyph {
                            text: index == root.current-index ? "\u{E73E}" : "";
                            color: Theme.text;
                            font-size: 14px;
                        }

                        Text {
                            text: option;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }

                    item-touch := TouchArea {
                        clicked => { root.current-index = index; }
                    }
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    in-out property <string> api-key;
    in-out property <bool> free-api: true;
    in-out property <bool> launch-at-startup;
    // Index into InterfaceLanguage::ALL: system, English, Korean.
    in-out property <int> interface-language;
    in property <string> message;
    in property <bool> dark-mode;
    in property <string> version;

    callback save-settings(string, bool, bool, int);
    callback cancel-settings();
    callback drag-requested();

    public function focus-key() {
        key-input.focus();
    }

    function save() {
        root.save-settings(root.api-key, root.free-api, root.launch-at-startup, root.interface-language);
    }

    title: @tr("DeepL Popup Settings");
    icon: root.dark-mode ? @image-url("../assets/icon-dark.png") : @image-url("../assets/icon-light.png");
    width: 460px;
    height: 512px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    init => {
        Theme.dark = root.dark-mode;
    }
    changed dark-mode => {
        Theme.dark = root.dark-mode;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }

    Rectangle {
        x: 15px;
        y: 15px;
        width: root.width - 30px;
        height: root.height - 30px;
        border-radius: 8px;
        background: Theme.card;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.card-shadow;

        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel-settings();
                    return accept;
                }
                return reject;
            }

            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.drag-requested();
                    }
                }
            }

            VerticalLayout {
                padding: 24px;
                padding-top: 16px;

                HorizontalLayout {
                    Text {
                        text: @tr("Settings");
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;

                        IconButton {
                            icon: "\u{E711}";
                            hint: @tr("Close");
                            clicked => { root.cancel-settings(); }
                        }
                    }
                }

                Rectangle { height: 16px; }

                Text {
                    text: @tr("DeepL API key");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }

                Rectangle { height: 6px; }

                key-input := TextField {
                    text <=> root.api-key;
                    placeholder: @tr("Enter your API key");
                    password: true;
                    accepted => { root.save(); }
                }

                Rectangle { height: 16px; }

                Text {
                    text: @tr("API plan");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }

                Rectangle { height: 6px; }

                HorizontalLayout {
                    alignment: start;

                    SegmentButton {
                        label: "Free";
                        first: true;
                        checked: root.free-api;
                        clicked => { root.free-api = true; }
                    }

                    SegmentButton {
                        label: "Pro";
                        last: true;
                        checked: !root.free-api;
                        clicked => { root.free-api = false; }
                    }
                }

                Rectangle { height: 12px; }

                Text {
                    text: @tr("The key is stored in Windows Credential Manager. Selected text is sent to the DeepL API.");
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle { height: 16px; }

                Text {
                    text: @tr("Startup");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }

                Rectangle { height: 6px; }

                ToggleSwitch {
                    label: @tr("Launch at Windows startup");
                    checked <=> root.launch-at-startup;
                }

                Rectangle { height: 16px; }

                Text {
                    text: @tr("Interface language");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                }

                Rectangle { height: 6px; }

                // Language names are written in their own language so anyone can find theirs.
                HorizontalLayout {
                    alignment: start;

                    SelectBox {
                        name: @tr("Interface language");
                        options: [@tr("System"), "English", "한국어"];
                        current-index <=> root.interface-language;
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 8px;
                }

                if root.message != "": Text {
                    text: root.message;
                    color: Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                Rectangle { height: 12px; }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "DeepL Popup " + root.version;
                        color: Theme.text-muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    ActionButton {
                        label: @tr("Cancel");
                        clicked => { root.cancel-settings(); }
                    }

                    ActionButton {
                        label: @tr("Save");
                        primary: true;
                        clicked => { root.save(); }
                    }
                }
            }
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    // Follows the taskbar theme, which can differ from the app theme.
    in property <bool> dark-taskbar: false;
    // The small-icon size in physical pixels. Windows does not rescale the
    // image well, so it picks the matching size from tools/generate-icons.ps1.
    in property <int> icon-size: 16;
    in property <string> version;
    callback menu-requested();
    callback open-requested();
    callback settings-requested();
    callback quit-requested();

    icon: root.dark-taskbar
        ? (root.icon-size <= 16 ? @image-url("../assets/tray-dark-16.png")
            : root.icon-size <= 20 ? @image-url("../assets/tray-dark-20.png")
            : root.icon-size <= 24 ? @image-url("../assets/tray-dark-24.png")
            : root.icon-size <= 32 ? @image-url("../assets/tray-dark-32.png")
            : root.icon-size <= 40 ? @image-url("../assets/tray-dark-40.png")
            : @image-url("../assets/tray-dark-48.png"))
        : (root.icon-size <= 16 ? @image-url("../assets/tray-light-16.png")
            : root.icon-size <= 20 ? @image-url("../assets/tray-light-20.png")
            : root.icon-size <= 24 ? @image-url("../assets/tray-light-24.png")
            : root.icon-size <= 32 ? @image-url("../assets/tray-light-32.png")
            : root.icon-size <= 40 ? @image-url("../assets/tray-light-40.png")
            : @image-url("../assets/tray-light-48.png"));
    tooltip: "DeepL Popup " + root.version + " · Ctrl+F9";
    title: "DeepL Popup";

    clicked => { root.menu-requested(); }

    Menu {
        MenuItem {
            title: @tr("Open");
            activated => { root.open-requested(); }
        }

        MenuItem {
            title: @tr("Settings");
            activated => { root.settings-requested(); }
        }

        MenuSeparator {}

        MenuItem {
            title: @tr("Quit");
            activated => { root.quit-requested(); }
        }
    }
}
